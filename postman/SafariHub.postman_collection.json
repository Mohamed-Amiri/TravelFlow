          "name": "Search Trips (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trips?page=0&size=10&sort=price,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trips"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "price,asc" }
